/* ═══════════════════════════════════════════
   CSS VARIABLES & RESET
═══════════════════════════════════════════ */
:root {
  --sky-pale:   #EAF6FF;
  --sky-soft:   #D0EAFC;
  --sky-mid:    #87CEEB;
  --blue-main:  #1E88E5;
  --blue-dark:  #1565C0;
  --blue-deeper:#0D47A1;
  --blue-glass: rgba(30,136,229,0.08);
  --white:      #FFFFFF;
  --grey-bg:    #F4F8FB;
  --grey-mid:   #E8EEF4;
  --grey-text:  #5A6A7A;
  --dark-text:  #1A2A3A;
  --shadow-soft: 0 4px 24px rgba(30,100,200,0.10);
  --shadow-card: 0 8px 40px rgba(30,100,200,0.13);
  --shadow-float:0 20px 60px rgba(30,100,200,0.18);
  --radius:     16px;
  --radius-sm:  10px;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  font-family:'DM Sans',sans-serif;
  background:var(--white);
  color:var(--dark-text);
  overflow-x:hidden;
}
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:var(--sky-pale);}
::-webkit-scrollbar-thumb{background:var(--blue-main);border-radius:3px;}

/* ═══════════════════════════════════════════
   NAVIGATION
═══════════════════════════════════════════ */
nav{
  position:fixed;top:0;width:100%;z-index:1000;
  padding:18px 5%;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(255,255,255,0.90);
  backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(135,206,235,0.3);
  transition:all 0.35s ease;
}
nav.scrolled{padding:12px 5%;box-shadow:var(--shadow-soft);}
.nav-logo{display:flex;align-items:center;gap:12px;text-decoration:none;}
.nav-logo-mark{
  width:44px;height:44px;border-radius:10px;
  background:linear-gradient(135deg,var(--blue-main),var(--blue-dark));
  display:flex;align-items:center;justify-content:center;
  font-size:22px;color:white;
  box-shadow:0 4px 14px rgba(30,136,229,0.35);
}
.nav-logo-text .brand{
  font-family:'Playfair Display';font-size:17px;font-weight:700;
  color:var(--dark-text);line-height:1.1;
}
.nav-logo-text .sub{font-size:10px;color:var(--grey-text);letter-spacing:1.5px;text-transform:uppercase;}
.nav-menu{display:flex;list-style:none;gap:32px;}
.nav-menu a{
  text-decoration:none;font-size:13px;font-weight:500;letter-spacing:0.5px;
  color:var(--grey-text);transition:color 0.2s;position:relative;
}
.nav-menu a::after{
  content:'';position:absolute;bottom:-3px;left:0;right:0;height:2px;
  background:var(--blue-main);transform:scaleX(0);transition:transform 0.25s;
}
.nav-menu a:hover{color:var(--blue-main);}
.nav-menu a:hover::after{transform:scaleX(1);}
.nav-call{
  background:var(--blue-main);color:white;
  padding:10px 24px;border-radius:50px;
  font-size:13px;font-weight:600;text-decoration:none;
  display:flex;align-items:center;gap:7px;
  transition:all 0.25s;
  box-shadow:0 4px 16px rgba(30,136,229,0.3);
}
.nav-call:hover{background:var(--blue-dark);transform:translateY(-1px);box-shadow:0 8px 24px rgba(30,136,229,0.4);}
.mob-btn{display:none;background:none;border:none;font-size:26px;color:var(--dark-text);cursor:pointer;}

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
#hero{
  min-height:100vh;
  background:linear-gradient(160deg, #EAF6FF 0%, #D4ECFF 35%, #C2E3FF 60%, #EAF6FF 100%);
  position:relative;overflow:hidden;
  display:flex;align-items:center;
  padding:130px 5% 80px;
}
#hero-canvas{
  position:absolute;right:0;top:0;
  width:55%;height:100%;
  pointer-events:none;
}
.hero-decor-ring{
  position:absolute;
  border-radius:50%;
  border:1.5px solid rgba(30,136,229,0.12);
  animation:spinSlow linear infinite;
}
@keyframes spinSlow{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
.hero-content{position:relative;z-index:10;max-width:620px;}
.hero-tag{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(30,136,229,0.1);border:1px solid rgba(30,136,229,0.25);
  color:var(--blue-dark);padding:6px 16px;border-radius:50px;
  font-size:12px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;
  margin-bottom:24px;
  animation:fadeInDown 0.8s ease both;
}
.hero-tag::before{content:'⭐';font-size:11px;}
.hero-h1{
  font-family:'Playfair Display';
  font-size:clamp(36px,5.5vw,68px);
  font-weight:800;line-height:1.08;
  color:var(--dark-text);
  animation:fadeInUp 0.9s 0.15s ease both;
}
.hero-h1 em{color:var(--blue-main);font-style:normal;}
.hero-line{
  width:72px;height:3px;margin:22px 0;
  background:linear-gradient(90deg,var(--blue-main),var(--sky-mid));
  border-radius:2px;
  animation:fadeInUp 0.9s 0.25s ease both;
}
.hero-p{
  font-size:17px;color:var(--grey-text);line-height:1.8;font-weight:300;
  max-width:520px;
  animation:fadeInUp 0.9s 0.35s ease both;
}
.hero-btns{
  display:flex;gap:14px;flex-wrap:wrap;margin-top:32px;
  animation:fadeInUp 0.9s 0.45s ease both;
}
.btn-blue{
  display:inline-flex;align-items:center;gap:8px;
  background:linear-gradient(135deg,var(--blue-main),var(--blue-dark));
  color:white;padding:15px 32px;border-radius:50px;
  font-size:14px;font-weight:600;text-decoration:none;
  box-shadow:0 8px 28px rgba(30,136,229,0.35);
  transition:all 0.25s;
}
.btn-blue:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(30,136,229,0.45);}
.btn-outline{
  display:inline-flex;align-items:center;gap:8px;
  background:white;color:var(--blue-main);padding:15px 32px;border-radius:50px;
  font-size:14px;font-weight:600;text-decoration:none;
  border:2px solid rgba(30,136,229,0.25);
  transition:all 0.25s;
  box-shadow:var(--shadow-soft);
}
.btn-outline:hover{border-color:var(--blue-main);transform:translateY(-2px);}
.hero-badges{
  display:flex;gap:24px;margin-top:44px;flex-wrap:wrap;
  animation:fadeInUp 0.9s 0.6s ease both;
}
.hero-badge-item{
  display:flex;align-items:center;gap:9px;
  background:white;padding:10px 18px;border-radius:12px;
  box-shadow:var(--shadow-soft);
  border:1px solid rgba(135,206,235,0.4);
}
.hero-badge-item .ico{font-size:20px;}
.hero-badge-item .txt{font-size:12px;font-weight:600;color:var(--dark-text);}
.hero-badge-item .sub{font-size:10px;color:var(--grey-text);}

/* ═══════════════════════════════════════════
   TRUST RIBBON
═══════════════════════════════════════════ */
.trust-ribbon{
  background:linear-gradient(135deg,var(--blue-dark),var(--blue-main));
  padding:22px 5%;overflow:hidden;
}
.trust-track{
  display:flex;gap:48px;align-items:center;white-space:nowrap;
  animation:marquee 22s linear infinite;
}
@keyframes marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}</p>
.trust-item{
  display:flex;align-items:center;gap:10px;
  color:rgba(255,255,255,0.9);font-size:13px;font-weight:500;letter-spacing:0.5px;
  flex-shrink:0;
}
.trust-item .dot{color:rgba(255,255,255,0.4);font-size:6px;}
.trust-item .ico{font-size:16px;}

/* ═══════════════════════════════════════════
   SECTION SHARED
═══════════════════════════════════════════ */
.section{padding:90px 5%;}
.section-alt{background:var(--grey-bg);}
.sec-label{
  font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;
  color:var(--blue-main);margin-bottom:10px;
}
.sec-title{
  font-family:'Playfair Display';
  font-size:clamp(30px,4vw,52px);font-weight:700;
  color:var(--dark-text);line-height:1.15;margin-bottom:14px;
}
.sec-title em{color:var(--blue-main);font-style:normal;}
.sec-line{width:56px;height:3px;background:var(--blue-main);border-radius:2px;margin:16px 0;}
.sec-desc{font-size:16px;color:var(--grey-text);line-height:1.85;font-weight:300;}

/* ═══════════════════════════════════════════
   ABOUT
═══════════════════════════════════════════ */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;}
.about-visual{position:relative;}
.about-frame{
  background:linear-gradient(135deg,var(--sky-pale),var(--sky-soft));
  border-radius:24px;aspect-ratio:1;
  display:flex;align-items:center;justify-content:center;
  border:1px solid rgba(135,206,235,0.5);
  overflow:hidden;position:relative;
  box-shadow:var(--shadow-float);
}
.about-svg-wrap{width:80%;height:80%;display:flex;align-items:center;justify-content:center;}
.about-pill{
  position:absolute;background:white;border-radius:14px;padding:14px 18px;
  box-shadow:var(--shadow-card);border:1px solid rgba(135,206,235,0.4);
  display:flex;align-items:center;gap:10px;
}
.about-pill .icon{font-size:26px;}
.about-pill .pnum{font-family:'Montserrat';font-size:22px;font-weight:800;color:var(--blue-main);}
.about-pill .ptxt{font-size:11px;color:var(--grey-text);font-weight:500;}
.pill-tl{top:-20px;left:-20px;}
.pill-br{bottom:-20px;right:-20px;}
.about-text ul{list-style:none;margin-top:20px;}
.about-text ul li{
  padding:11px 0;border-bottom:1px solid var(--grey-mid);
  display:flex;align-items:center;gap:12px;
  font-size:14px;color:var(--grey-text);font-weight:400;
}
.about-text ul li::before{
  content:'';width:8px;height:8px;border-radius:50%;
  background:var(--blue-main);flex-shrink:0;
}

/* ═══════════════════════════════════════════
   PRODUCTS
═══════════════════════════════════════════ */
.products-header{text-align:center;margin-bottom:50px;}
.products-header .sec-line{margin:16px auto;}
.prod-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
  gap:24px;
}
.prod-card{
  background:white;
  border-radius:var(--radius);
  border:1px solid rgba(135,206,235,0.3);
  overflow:hidden;
  transition:all 0.35s cubic-bezier(.2,.8,.3,1.1);
  cursor:pointer;
  position:relative;
}
.prod-card:hover{
  transform:translateY(-8px) scale(1.01);
  box-shadow:var(--shadow-float);
  border-color:rgba(30,136,229,0.35);
}
.prod-card::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(30,136,229,0.04),transparent);
  opacity:0;transition:opacity 0.3s;pointer-events:none;
}
.prod-card:hover::after{opacity:1;}
.prod-img{
  height:165px;
  display:flex;align-items:center;justify-content:center;
  font-size:60px;position:relative;
  overflow:hidden;
}
.prod-img-overlay{
  position:absolute;inset:0;
  background:linear-gradient(0deg,rgba(30,80,160,0.12) 0%,transparent 70%);
}
.prod-body{padding:20px;}
.prod-tag{
  font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:var(--blue-main);margin-bottom:6px;
}
.prod-name{
  font-family:'Playfair Display';font-size:19px;font-weight:700;
  color:var(--dark-text);margin-bottom:8px;
}
.prod-desc{font-size:13px;color:var(--grey-text);line-height:1.65;}
.prod-footer{
  padding:14px 20px;
  border-top:1px solid var(--grey-mid);
  display:flex;align-items:center;justify-content:space-between;
}
.prod-footer a{
  font-size:12px;font-weight:600;letter-spacing:0.5px;
  color:var(--blue-main);text-decoration:none;
  display:flex;align-items:center;gap:5px;
  transition:gap 0.2s;
}
.prod-footer a:hover{gap:9px;}
.prod-quality{font-size:11px;color:var(--grey-text);}

/* ═══════════════════════════════════════════
   WHY CHOOSE US
═══════════════════════════════════════════ */
.why-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));
  gap:22px;margin-top:50px;
}
.why-card{
  padding:30px 26px;
  background:white;
  border-radius:var(--radius);
  border:1px solid rgba(135,206,235,0.3);
  transition:all 0.3s;
  position:relative;overflow:hidden;
}
.why-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--blue-main),var(--sky-mid));
  transform:scaleX(0);transform-origin:left;
  transition:transform 0.35s;
}
.why-card:hover::before{transform:scaleX(1);}
.why-card:hover{box-shadow:var(--shadow-card);transform:translateY(-4px);}
.why-icon{
  width:52px;height:52px;border-radius:14px;
  background:linear-gradient(135deg,rgba(30,136,229,0.12),rgba(135,206,235,0.15));
  display:flex;align-items:center;justify-content:center;
  font-size:26px;margin-bottom:16px;
}
.why-title{font-family:'Playfair Display';font-size:17px;font-weight:700;color:var(--dark-text);margin-bottom:8px;}
.why-text{font-size:13px;color:var(--grey-text);line-height:1.7;}

/* ═══════════════════════════════════════════
   STATS
═══════════════════════════════════════════ */
.stats-section{
  background:linear-gradient(135deg,var(--blue-deeper),var(--blue-dark),var(--blue-main));
  padding:70px 5%;position:relative;overflow:hidden;
}
.stats-section::before{
  content:'';position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.stats-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:40px;text-align:center;position:relative;
}
.stat-card{color:white;}
.stat-ico{font-size:32px;margin-bottom:10px;opacity:0.85;}
.stat-num{
  font-family:'Montserrat';font-size:clamp(40px,6vw,68px);font-weight:800;
  line-height:1;color:white;
}
.stat-num span{font-size:60%;color:rgba(255,255,255,0.7);}
.stat-lbl{font-size:13px;color:rgba(255,255,255,0.75);letter-spacing:1.5px;text-transform:uppercase;margin-top:6px;font-weight:500;}

/* ═══════════════════════════════════════════
   TESTIMONIALS
═══════════════════════════════════════════ */
.testi-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
  gap:24px;margin-top:50px;
}
.testi-card{
  background:white;border-radius:var(--radius);padding:30px;
  border:1px solid rgba(135,206,235,0.3);
  transition:all 0.3s;position:relative;
  box-shadow:var(--shadow-soft);
}
.testi-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-card);}
.quote-mark{
  font-family:'Playfair Display';font-size:72px;line-height:0.7;
  color:rgba(30,136,229,0.12);float:left;margin-right:6px;margin-top:10px;
}
.testi-text{font-size:14px;color:var(--grey-text);line-height:1.8;margin-bottom:22px;font-style:italic;overflow:hidden;}
.testi-foot{display:flex;align-items:center;gap:12px;}
.testi-av{
  width:46px;height:46px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,var(--blue-main),var(--sky-mid));
  display:flex;align-items:center;justify-content:center;
  font-family:'Montserrat';font-size:16px;font-weight:800;color:white;
}
.testi-name{font-weight:700;font-size:14px;color:var(--dark-text);}
.testi-loc{font-size:12px;color:var(--grey-text);}
.testi-stars{color:#FFC107;font-size:13px;letter-spacing:1px;margin-bottom:10px;}

/* ═══════════════════════════════════════════
   GALLERY
═══════════════════════════════════════════ */
.gallery-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  grid-template-rows:repeat(2,190px);
  gap:14px;margin-top:50px;
}
.gallery-cell{
  border-radius:var(--radius-sm);overflow:hidden;
  background:linear-gradient(135deg,var(--sky-pale),var(--sky-soft));
  display:flex;align-items:center;justify-content:center;
  font-size:48px;position:relative;cursor:pointer;
  border:1px solid rgba(135,206,235,0.4);
  transition:all 0.35s;
}
.gallery-cell:hover{transform:scale(1.02);box-shadow:var(--shadow-float);z-index:5;}
.gallery-cell:hover .gallery-caption{opacity:1;transform:translateY(0);}
.gallery-cell:nth-child(1){grid-column:span 2;}
.gallery-cell:nth-child(5){grid-column:span 2;}
.gallery-caption{
  position:absolute;bottom:0;left:0;right:0;
  padding:12px 16px;
  background:linear-gradient(0deg,rgba(21,101,192,0.85),transparent);
  color:white;font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
  opacity:0;transform:translateY(8px);transition:all 0.3s;
}

/* ═══════════════════════════════════════════
   CONTACT
═══════════════════════════════════════════ */
.contact-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:60px;align-items:start;}
.contact-info{display:flex;flex-direction:column;gap:18px;}
.c-card{
  background:white;border-radius:var(--radius);padding:22px;
  border:1px solid rgba(135,206,235,0.35);
  display:flex;align-items:flex-start;gap:16px;
  box-shadow:var(--shadow-soft);
  transition:all 0.3s;
}
.c-card:hover{transform:translateX(6px);border-color:rgba(30,136,229,0.4);}
.c-ico{
  width:50px;height:50px;border-radius:12px;flex-shrink:0;
  background:linear-gradient(135deg,rgba(30,136,229,0.12),rgba(135,206,235,0.2));
  display:flex;align-items:center;justify-content:center;font-size:22px;
}
.c-label{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--blue-main);margin-bottom:4px;}
.c-val{font-size:15px;font-weight:600;color:var(--dark-text);}
.c-sub{font-size:12px;color:var(--grey-text);margin-top:2px;}
.cta-group{display:flex;flex-direction:column;gap:12px;margin-top:6px;}
.cta-full{
  display:flex;align-items:center;justify-content:center;gap:10px;
  padding:15px 24px;border-radius:14px;
