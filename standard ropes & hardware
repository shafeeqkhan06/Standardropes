  transition:all 0.25s;border:none;cursor:pointer;font-family:'DM Sans';
}
.cta-phone{background:linear-gradient(135deg,var(--blue-main),var(--blue-dark));color:white;box-shadow:0 6px 22px rgba(30,136,229,0.3);}
.cta-phone:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(30,136,229,0.4);}
.cta-wa{background:#25D366;color:white;box-shadow:0 6px 22px rgba(37,211,102,0.3);}
.cta-wa:hover{transform:translateY(-2px);background:#22c65e;}
.cta-map{background:var(--grey-bg);color:var(--dark-text);border:1.5px solid var(--grey-mid);}
.cta-map:hover{border-color:var(--blue-main);color:var(--blue-main);}

/* Form */
.form-box{
  background:white;border-radius:20px;padding:36px;
  box-shadow:var(--shadow-card);border:1px solid rgba(135,206,235,0.3);
}
.form-box h3{
  font-family:'Playfair Display';font-size:26px;font-weight:700;
  color:var(--dark-text);margin-bottom:24px;
}
