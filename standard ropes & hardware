<script>
// ── NAV SCROLL ──────────────────────────
window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', scrollY > 60);
});

// ── INTERSECTION OBSERVER ──────────────
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal,.stagger').forEach(el => io.observe(el));

// ── COUNTER ANIMATION ──────────────────
let counted = false;
const statsObs = new IntersectionObserver(entries => {
  if(entries[0].isIntersecting && !counted) {
    counted = true;
    count('c1', 1000, 1600);
    count('c2', 100, 1200);
  }
}, { threshold: 0.5 });
statsObs.observe(document.getElementById('stats'));
function count(id, target, dur) {
  const el = document.getElementById(id);
  if(!el) return;
  let start = 0, step = target / (dur / 16);
  const t = setInterval(() => {
    start += step;
    if(start >= target) { el.textContent = target.toLocaleString(); clearInterval(t); }
    else el.textContent = Math.floor(start).toLocaleString();
  }, 16);
}

// ── FORM ───────────────────────────────
function sendInquiry() {
  if(!document.getElementById('fn').value.trim() || !document.getElementById('fp').value.trim()) {
    alert('Please enter your name and phone number.');
    return;
  }
  const ok = document.getElementById('formOk');
  ok.style.display = 'block';
  ['fn','fp','fprod','fmsg'].forEach(id => document.getElementById(id).value = '');
  setTimeout(() => ok.style.display = 'none', 6000);
}

// ── THREE.JS ROPE ANIMATION ──────────
(function() {
  const canvas = document.getElementById('hero-canvas');
  if(!canvas || typeof THREE === 'undefined') return;

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
  camera.position.set(0, 0, 8);

  function resize() {
    const w = canvas.clientWidth, h = canvas.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  resize();
  window.addEventListener('resize', resize);

  // Lights
  const ambLight = new THREE.AmbientLight(0xEAF6FF, 0.8);
  scene.add(ambLight);
  const dirLight = new THREE.DirectionalLight(0x1E88E5, 1.4);
  dirLight.position.set(5, 5, 5);
  scene.add(dirLight);
  const pointLight = new THREE.PointLight(0x87CEEB, 1.2, 20);
  pointLight.position.set(-3, 2, 3);
  scene.add(pointLight);

  // Rope segments (torus group = coiled rope)
  const ropeGroup = new THREE.Group();
  scene.add(ropeGroup);

  const ropeMat = new THREE.MeshStandardMaterial({
    color: 0x1E88E5,
    roughness: 0.35,
    metalness: 0.1,
  });

  // Create coil from multiple torus rings
  const coilCount = 7;
  for(let i = 0; i < coilCount; i++) {
    const t = i / coilCount;
    const radius = 2.0 - t * 0.6;
    const geo = new THREE.TorusGeometry(radius, 0.14, 16, 80);
    const mesh = new THREE.Mesh(geo, ropeMat.clone());
    mesh.rotation.x = Math.PI / 2 + (i * 0.12);
    mesh.position.y = -1.2 + i * 0.42;
    mesh.material.color.setHSL(0.58, 0.75, 0.35 + t * 0.25);
    ropeGroup.add(mesh);
  }

  // Floating hardware elements
  const hwGroup = new THREE.Group();
  scene.add(hwGroup);
  const shapes = [
    new THREE.OctahedronGeometry(0.18),
    new THREE.BoxGeometry(0.25,0.25,0.25),
    new THREE.SphereGeometry(0.14,16,16),
    new THREE.CylinderGeometry(0.1,0.1,0.3,16),
    new THREE.OctahedronGeometry(0.14),
    new THREE.BoxGeometry(0.2,0.2,0.2),
  ];
  const hwMeshes = shapes.map((geo, i) => {
    const mat = new THREE.MeshStandardMaterial({
      color: [0x1E88E5,0x87CEEB,0x0D47A1,0x42A5F5,0x90CAF9,0x1565C0][i],
      roughness: 0.4, metalness: 0.4, transparent: true, opacity: 0.6
    });
    const m = new THREE.Mesh(geo, mat);
    const angle = (i / shapes.length) * Math.PI * 2;
    m.position.set(Math.cos(angle)*3.2, Math.sin(angle)*2.2, (i%2?1:-1)*0.8);
    m.userData = { speed: 0.008 + i*0.003, amp: 0.3 + i*0.1, phase: i*1.1 };
    hwGroup.add(m);
    return m;
  });

  // Particle field
  const particleCount = 180;
  const pPositions = new Float32Array(particleCount * 3);
  for(let i=0; i<particleCount*3; i++) pPositions[i] = (Math.random()-0.5)*14;
  const pGeo = new THREE.BufferGeometry();
  pGeo.setAttribute('position', new THREE.BufferAttribute(pPositions,3));
  const pMat = new THREE.PointsMaterial({color:0x87CEEB,size:0.06,transparent:true,opacity:0.5});
  scene.add(new THREE.Points(pGeo,pMat));

  let t = 0;
  function animate() {
    requestAnimationFrame(animate);
    t += 0.008;
    ropeGroup.rotation.y = t * 0.4;
    ropeGroup.rotation.z = Math.sin(t*0.5)*0.15;
    hwMeshes.forEach((m,i) => {
      const d = m.userData;
      m.rotation.x += d.speed * 1.2;
      m.rotation.y += d.speed;
      const angle = t * d.speed * 12 + d.phase;
      m.position.y = Math.sin(angle) * d.amp + (i%3 - 1)*1.5;
    });
    renderer.render(scene, camera);
  }
  animate();
})();
</script>
